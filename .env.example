# ─────────────────────────────────────────────────────────────────────────
# East End Mandarin — environment variables
# Copy this file to `.env.local` and fill in the value, then restart the dev
# server. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────────────────

# Web3Forms access key — powers the no-backend contact form.
# 1. Get a free key at https://web3forms.com (enter the email that should
#    receive inquiries; no account required).
# 2. Paste the key below.
#
# Note: the form submits directly from the browser, so this value must be
# exposed to the client. Next.js only exposes vars prefixed with NEXT_PUBLIC_.
# Web3Forms access keys are designed to be public, so this is safe.
NEXT_PUBLIC_FORM_ACCESS_KEY=YOUR_WEB3FORMS_ACCESS_KEY_HERE
